if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print_help()
        sys.exit(0)

    method = sys.argv[1]
    data = {}

    for arg in sys.argv[2:]:
        if "=" in arg:
            key, val = arg.split("=", 1)
            data[key] = parse_value(val)
        else:
            print(f"Varovanie: Neplatný argument '{arg}' (chyba znak '=')", file=sys.stderr)

    response = wayfire_request(method, data)
    print(json.dumps(response, indent=2))