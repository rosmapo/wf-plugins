#!/usr/bin/env python3

import os
import sys
import socket
import struct
import json

SOCKET_PATH = os.environ.get("WAYFIRE_SOCKET")

def wayfire_request(method, data=None):
    if not SOCKET_PATH:
        print("Chyba: WAYFIRE_SOCKET nie je nastavený.", file=sys.stderr)
        sys.exit(1)

    if data is None:
        data = {}

    message = json.dumps({"method": method, "data": data}).encode()
    packet = struct.pack("<I", len(message)) + message

    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
            sock.connect(SOCKET_PATH)
            sock.sendall(packet)

            header = sock.recv(4)
            if len(header) != 4:
                raise RuntimeError("Wayfire nevrátil platnú odpoveď.")

            length = struct.unpack("<I", header)[0]
            response = b""
            while len(response) < length:
                chunk = sock.recv(length - len(response))
                if not chunk:
                    raise RuntimeError("Wayfire prerušil spojenie.")
                response += chunk

        result = json.loads(response)
        if "error" in result:
            print(f"Chyba od Wayfiru: {result['error']}", file=sys.stderr)
            sys.exit(1)

        return result
    except Exception as e:
        print(f"Chyba pri komunikácii: {e}", file=sys.stderr)
        sys.exit(1)

def parse_value(val_str):
    """Automaticky skonvertuje reťazec na int, float, bool alebo nechá ako str."""
    if val_str.lower() == "true":
        return True
    if val_str.lower() == "false":
        return False
    try:
        if "." in val_str:
            return float(val_str)
        return int(val_str)
    except ValueError:
        return val_str

